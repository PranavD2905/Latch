DATABASE_URL=postgres://latch:latch@localhost:5432/latch

# Razorpay test-mode keys. Required for the RazorpayPaymentProvider live
# integration test (src/adapters/payment/razorpay-payment-provider.live.integration.test.ts)
# and for `npm run mcp:dev:razorpay`. Get these from Dashboard > Test Mode > API Keys.
# Never commit real values here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# dev-logs/014: the webhook secret Razorpay signs `POST /webhooks/razorpay`
# deliveries with (Dashboard > Webhooks, or the Webhooks API). Undefined
# disables that route (503) rather than crashing merchant-api on boot.
RAZORPAY_WEBHOOK_SECRET=

# Migration 0011: the merchant-API and audit-trail-viewer tokens are no
# longer static env vars — they're real, per-merchant, DB-issued credentials
# now (src/ports/merchant-auth.ts), so nothing to set here. Run
# `npm run db:seed` (mints one of each for the seed merchant and prints them
# once) or `npm run db:create-merchant -- "Clinic name"` (onboards a new
# merchant the same way) to get one. Neither is stored anywhere in plaintext
# — copy it down when it prints, the same as any other issued API key.

# dev-logs/023: everything below is validated at startup by
# src/adapters/config.ts (`loadEnv()`) — an unset var falls back to the
# default named below; a set-but-invalid one (e.g. a non-numeric port) fails
# fast with a clear error instead of a confusing runtime one later. Nothing
# below needs to be set for local dev; every default already matches this
# file's own local-dev defaults.

# NODE_ENV=development          # 'production' switches logging to plain JSON (dev-logs/017) instead of pino-pretty
# LOG_LEVEL=info                # fatal|error|warn|info|debug|trace|silent
# PORT=                         # Railway injects this per service; leave unset locally
# MCP_HTTP_PORT=4000
# MERCHANT_API_PORT=4001
# AUDIT_TRAIL_PORT=4002
# REST_PORT=4003

# PAYMENT_PROVIDER=razorpay     # unset (or anything else) uses FakePaymentProvider/FakePaymentRail — dev-logs/006
# PAYMENT_RAIL=reserve_pay      # not a supported runtime mode (dev-logs/005/007) — proves the swap is a module boundary

# DB_POOL_MAX=5
# DB_IDLE_TIMEOUT_SECONDS=60
# DB_MAX_LIFETIME_SECONDS=1800
# DB_TRANSACTION_POOLER=false   # set true only when DATABASE_URL points at a transaction-mode pooler (PgBouncer, Railway's pooling add-on)

# MCP_RATE_LIMIT_MAX=300               # transport-level DoS throttle (dev-logs/017), distinct from hold_slot's own DB-backed business rate limit
# MCP_RATE_LIMIT_WINDOW_MS=60000

# BACKGROUND_WORKER_INTERVAL_MS=60000
# AUTHORIZATION_LAPSE_WORKER_INTERVAL_MS=60000
# RECONCILIATION_WORKER_INTERVAL_MS=60000

# GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000   # dev-logs/022

# dev-logs/024 — off by default: a live OTel SDK and span export cost real overhead most local/test runs shouldn't pay for.
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=         # unset -> spans print to the console; set for a real collector in any deployed environment

# dev-logs/025 — unset keeps merchant-api's existing origin:true (reflect the
# caller's own Origin; the Bearer-token hook is the real gate, not CORS).
# CORS_ALLOWED_ORIGINS=                # comma-separated list to restrict it instead
