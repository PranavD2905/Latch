{
  "name": "latch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "build:viewer": "npm run build && npm run build:web",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/adapters/db/migrate.ts",
    "db:seed": "tsx src/adapters/db/seed.ts",
    "mcp:dev": "tsx src/adapters/mcp/stdio.ts",
    "mcp:dev:razorpay": "PAYMENT_PROVIDER=razorpay tsx src/adapters/mcp/stdio.ts",
    "mcp:http:dev": "tsx src/adapters/mcp/http.ts",
    "mcp:http:dev:razorpay": "PAYMENT_PROVIDER=razorpay tsx src/adapters/mcp/http.ts",
    "merchant-api:dev": "tsx src/adapters/merchant-api/http.ts",
    "merchant-api:dev:razorpay": "PAYMENT_PROVIDER=razorpay tsx src/adapters/merchant-api/http.ts",
    "worker:dev": "tsx src/adapters/worker/authorization-lapse.ts",
    "worker:dev:razorpay": "PAYMENT_PROVIDER=razorpay tsx src/adapters/worker/authorization-lapse.ts",
    "worker:background:dev": "tsx src/adapters/worker/background.ts",
    "worker:background:dev:razorpay": "PAYMENT_PROVIDER=razorpay tsx src/adapters/worker/background.ts",
    "audit-trail:dev": "tsx src/adapters/audit-trail/http.ts",
    "audit-trail:dev:razorpay": "PAYMENT_PROVIDER=razorpay tsx src/adapters/audit-trail/http.ts",
    "web:dev": "npm --prefix web run dev",
    "demo:ceiling-refusal": "tsx src/adapters/demo/ceiling-refusal.ts",
    "demo:ceiling-refusal:razorpay": "PAYMENT_PROVIDER=razorpay tsx src/adapters/demo/ceiling-refusal.ts",
    "start:mcp": "node dist/adapters/mcp/http.js",
    "start:merchant-api": "node dist/adapters/merchant-api/http.js",
    "start:viewer": "node dist/adapters/audit-trail/http.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.12.1",
    "postgres": "^3.4.5",
    "razorpay": "^2.9.8",
    "ulid": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.28.1",
    "railway": "^3.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
